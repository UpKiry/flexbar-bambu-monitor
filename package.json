{
  "version": "0.5.0",
  "scripts": {
    "admin:dev": "node scripts/admin-dev.js",
    "build": "rollup -c",
    "dev": "npm-run-all plugin:unlink plugin:link -p plugin:watch plugin:debug",
    "plugin:watch": "rollup -c -w --watch.onEnd=\"npm run plugin:restart\"",
    "plugin:unlink": "flexcli plugin unlink --uuid com.upkiry.bambumonitor --silent",
    "plugin:link": "flexcli plugin link --path com.upkiry.bambumonitor.plugin --uuid com.upkiry.bambumonitor --start false",
    "plugin:restart": "flexcli plugin restart --uuid=com.upkiry.bambumonitor",
    "plugin:debug": "flexcli plugin debug --uuid=com.upkiry.bambumonitor",
    "plugin:validate": "flexcli plugin validate --path com.upkiry.bambumonitor.plugin",
    "plugin:pack": "flexcli plugin pack --path com.upkiry.bambumonitor.plugin",
    "plugin:install": "flexcli plugin install --path ./com.upkiry.bambumonitor.flexplugin --force",
    "test": "node --test"
  },
  "type": "commonjs",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "glob": "^11.0.1",
    "npm-run-all": "^4.1.5",
    "rollup": "^4.0.2"
  },
  "dependencies": {
    "@eniac/flexdesigner": "^1.0.7",
    "mqtt": "^5.10.4"
  }
}
