{
    "name": "Bambu Monitor",
    "uuid": "com.upkiry.bambumonitor",
    "version": "0.7.0",
    "author": "upkiry",
    "entry": "backend/plugin.cjs",
    "description": "在 Flexbar 上监控 Bambu Lab 打印机的云端状态与打印进度",
    "repo": "https://github.com/UpKiry/flexbar-bambu-monitor",
    "sdk": {
        "version": "1.0.7"
    },
    "software": {
        "minimumVersion": "1.3.0"
    },
    "os": [
        {
            "platform": "mac",
            "minimumVersion": "10.15"
        },
        {
            "platform": "windows",
            "minimumVersion": "10"
        }
    ],
    "device": [
        {
            "name": "flexbar",
            "version": "1.0.0"
        }
    ],
    "configPage": "configPage",
    "keyLibrary": {
        "title": "$PluginName",
        "style": {
            "icon": "mdi mdi-printer-3d"
        },
        "children": [
            {
                "title": "打印机状态",
                "tip": "选择打印机；触摸屏幕请求完整状态",
                "cid": "com.upkiry.bambumonitor.monitor",
                "config": {
                    "keyType": "directDraw",
                    "clickable": true,
                    "platform": [
                        "windows",
                        "mac"
                    ]
                },
                "style": {
                    "icon": "mdi mdi-printer-3d",
                    "width": 240
                },
                "data": {
                    "printerId": ""
                }
            }
        ]
    },
    "local": {
        "zh-CN": {
            "PluginName": "Bambu 监控"
        },
        "en": {
            "PluginName": "Bambu Monitor"
        }
    }
}
